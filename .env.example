# Databricks Agent Configuration
# Copy this file to .env and fill in your actual values

# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=your-project-id-adk-staging

# AgentSpace Configuration
AGENTSPACE_APP_ID=agentspace-demo_1234567890
AGENT_DISPLAY_NAME=Databricks Agent
AGENT_DESCRIPTION=Agent para queries no Databricks com análise avançada
AGENT_ICON_URI=https://fonts.gstatic.com/s/i/short-term/release/googlesymbols/database/default/24px.svg

# Databricks OAuth M2M Configuration (standard SDK variables)
# Create a service principal and OAuth secret in your Databricks workspace
# See: https://docs.databricks.com/aws/en/dev-tools/auth/oauth-m2m
DATABRICKS_CLIENT_ID=your-service-principal-client-id
DATABRICKS_CLIENT_SECRET=your-service-principal-oauth-secret
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# Databricks Connection
DATABRICKS_SQL_WAREHOUSE_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_CATALOG=samples
DATABRICKS_SCHEMA=nyctaxi

# Model Configuration
ROOT_AGENT_MODEL=gemini-2.5-flash
DATABRICKS_AGENT_MODEL=gemini-2.5-flash
ANALYTICS_AGENT_MODEL=gemini-2.5-flash
BASELINE_NL2SQL_MODEL=gemini-2.5-flash

# NL2SQL Method
NL2SQL_METHOD=BASELINE

# Authentication - M2M OAuth (automatic via SDK)
# AUTH_ID no longer needed for M2M flow
CODE_INTERPRETER_EXTENSION_NAME=
